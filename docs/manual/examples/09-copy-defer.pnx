rem run
use io .
use file .
rem The same copy with defer: each file is closed once, on every way out.
def copy_lines source str, target str gives n int or fail do
  source file.open_read or_fail to src
  defer src file.close end
  target file.open_write or_fail to dst
  defer dst file.close end
  0 to n
  loop
    src file.read_line or_else to e break . end to line
    args line "\n" . cat dst file.write or_fail
    n 1 add to n
  end
  n
end
def setup or fail do
  "in.txt" file.open_write or_fail to f
  defer f file.close end
  "one\ntwo\nthree\n" f file.write or_fail
end
setup or_else to e end
def main do args "copied " "in.txt" "out.txt" copy_lines or_else to e -1 end " lines" . cat io.println end
main
