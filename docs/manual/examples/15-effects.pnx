rem see-effects
use io .
use file .
global hits int
def double n int gives int do n 2 mul end
def tally n int do hits n add set hits end
def save path str or fail do
  path file.open_write or_fail to f
  defer f file.close end
  args "hits " hits . cat f file.write or_fail
end
def say do args "hits " hits double . cat io.println end
