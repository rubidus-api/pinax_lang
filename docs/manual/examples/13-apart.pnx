rem run
use io
tasks workers 2 apart
global zero int
word demo ()
  do "the healthy task starts" io.println yield or_return "and finishes" io.println end workers spawn or_else (e) return end drop
  do 1 zero div drop end workers spawn or_else (e) return end drop
  workers run_all
  "the run goes on" io.println
end
demo
