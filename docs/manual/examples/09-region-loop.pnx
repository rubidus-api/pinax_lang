rem run
use io .
use str .
rem Make a long report in a small region: each turn gives its bytes back.
buffer report 4096
def build or fail do
  1 200 range do to i
    mark to m
    args "row " i ": " i i mul "\n" . cat report append or_else to e m release e fail end
    m release
  end each
end
build or_else to e args "full: " e err_text . cat io.println end
args "report: " report len " bytes" . cat io.println
