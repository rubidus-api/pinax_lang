rem run
use io
use str
word short (w str or fail)
  w str.len 5 gt if err.range fail end
end
word read_words (line str or fail)
  mark to m
  defer m release end
  line str.upper str.words do (w str) w short or_fail  w io.println end each
end
"one two three" read_words or_else (e) cat ("stopped: ", e err_text) io.println end
"one embeddable two" read_words or_else (e) cat ("stopped: ", e err_text) io.println end
