rem run
use io
use sheet
buffer grid 8192
word fill (or fail)
  6 3 grid sheet.init or_fail                 rem at most 6 rows, exactly 3 columns
  4 do grid sheet.add_row or_fail drop end times
  "apple" 0 0 grid sheet.put_str or_fail      rem name, row, column
  3 0 1 grid sheet.put_int or_fail
  "pear" 1 0 grid sheet.put_str or_fail
  5 1 1 grid sheet.put_int or_fail
  "pear" 2 0 grid sheet.put_str or_fail      rem the same text: stored once
  7 2 1 grid sheet.put_int or_fail
  true 2 2 grid sheet.put_bool or_fail
end
word price (name str gives int or fail)
  name 0 grid sheet.find_row_str or_fail     rem the first row whose column 0 is name
  1 swap grid sheet.int or_fail              rem the number in its column 1
end
word main (or fail)
  fill or_fail
  cat ("rows ", grid sheet.rows, ", columns ", grid sheet.cols) io.println
  cat ("pear costs ", "pear" price or_fail) io.println
  cat ("row 3 column 0 is ", 3 0 grid sheet.kind, " (empty is ", sheet.k_empty, ")") io.println
  "plum" price or_else (e) cat ("no plum: ", e err_text) io.println 0 end drop
  cat ("total ", 1 grid sheet.sum_col, ", dearest ", 1 grid sheet.max_col or_fail) io.println
end
main or_else (e) e err_text io.println end
