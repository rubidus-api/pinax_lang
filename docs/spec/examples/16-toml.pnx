rem run
use io
use toml
word main (or fail)
  text END
title = "Pinax"          # a comment
[server]
host = "localhost"
ports = [8080, 8081]
[[user]]
name = "kim"
[[user]]
name = "lee"
END
  to conf
  "title" conf toml.at or_fail io.println drop       rem the text of a string, without its quotes
  "server.ports[1]" conf toml.at or_fail io.println drop
  "user[1].name" conf toml.at or_fail io.println drop
  "server" conf toml.at or_fail drop toml.table eq to is_table
  cat ("server is a table: ", is_table) io.println
  conf to rest                                        rem every statement, in order
  loop
    rest toml.next or_else (e) break end to (kind, key, value, rest)
    cat (kind, " ", key, " [", value, "]") io.println
  end
end
main or_else (e) e err_text io.println end
