rem run
use io
use str
word check (w str or fail)
  w str.len 5 gt if err.range fail end
end
word words_of (line str or fail)
  loop
    mark to m
    defer m release end
    line str.lower str.words do (w str) w check or_fail  w io.println end each
    break
  end
end
"Pinax interprets" words_of or_else (e) cat ("failed: ", e err_text) io.println end
