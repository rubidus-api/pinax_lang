%YAML 1.2
---
# Pinax source, for the code blocks of the spec and the manual. MIT (see ../manual/LICENSE-CODE).
name: Pinax
file_extensions: [pnx]
scope: source.pinax

contexts:
  main:
    - match: '(?<![A-Za-z0-9_])rem(?![A-Za-z0-9_]).*$'
      scope: comment.line.pinax
    - match: '^(note)\s+([A-Za-z_][A-Za-z0-9_]*).*$'
      captures:
        1: comment.block.pinax
        2: comment.block.pinax
      push: note_body
    - match: '^\s*(text)\s+([A-Za-z_][A-Za-z0-9_]*)\s*$'
      captures:
        1: keyword.other.pinax
        2: entity.name.tag.pinax
      push: text_body
    - match: '(?<![A-Za-z0-9_])r"'
      push: raw_string
    - match: '"'
      push: string
    - match: "U?'(\\\\.|[^'])*'"
      scope: constant.character.pinax
    - match: '(?<![A-Za-z0-9_.])[+-]?(0x[0-9A-Fa-f_]+|0b[01_]+|[0-9][0-9_]*)(?![A-Za-z0-9_])'
      scope: constant.numeric.pinax
    - match: '(?<![A-Za-z0-9_.])(true|false|none)(?![A-Za-z0-9_])'
      scope: constant.language.pinax
    - match: '(?<![A-Za-z0-9_.])(word|global|const|array|list|pool|queue|buffer|tasks|record|type|extern|from|forward|index|bound|shared|make|test|row|assign|big_endian|columns|gives|or|fail|owned|to|do|end|if|else|loop|while|until|break|case|of|otherwise|return|or_fail|or_return|or_else|cat|use|as|export|pinax|redefine)(?![A-Za-z0-9_])'
      scope: keyword.control.pinax
    - match: '(?<![A-Za-z0-9_.])(int|bool|str|err|u8|i8|u16|i16|u32|i32|i64|regex|file|mark)(?![A-Za-z0-9_])'
      scope: storage.type.pinax
  note_body:
    - meta_scope: comment.block.pinax
    - match: '^[A-Za-z_][A-Za-z0-9_]*\s*$'
      pop: true
  text_body:
    - meta_scope: string.unquoted.pinax
    - match: '^[A-Za-z_][A-Za-z0-9_]*\s*$'
      scope: entity.name.tag.pinax
      pop: true
  string:
    - meta_scope: string.quoted.double.pinax
    - match: '\\.'
      scope: constant.character.escape.pinax
    - match: '"'
      pop: true
    - match: '$'
      pop: true
  raw_string:
    - meta_scope: string.quoted.double.pinax
    - match: '"'
      pop: true
    - match: '$'
      pop: true
