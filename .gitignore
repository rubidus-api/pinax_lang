# Whitelist: everything in this folder is private unless it is listed below.
# Private material lives in the sibling repository ../pinax_lang_private/ and
# appears here through relative symlinks, which this file keeps out of git.
# Public = what builds the product, README, LICENSE, and the spec and manual (docs/spec, docs/manual, docs/tools).
/*
!/.gitignore
!/README.md
!/README.ko.md
!/LICENSE
!/nob.c
!/include/
!/src/
!/vendor/
!/docs/
/docs/*
!/docs/spec/
!/docs/manual/
!/docs/tools/
!/docs/index.html
!/docs/.nojekyll

# The blocks below come from the bootstrap kit. With the whitelist above they
# are a second line of defence: they also apply inside the public directories.
/CHANGELOG.md
/tests
/resources

# ── Local operating docs ───────────────────────────────────────────────
# Working AI/operating state, never published. Under the default location
# (private-sibling) these are relative links into ../<project>_private/, where
# they are versioned. Only README.md, CHANGELOG.md, LICENSE, docs/manual/,
# tests/, the source and the project's own scripts are published.
# (This project: README, LICENSE, the source, docs/spec and docs/manual only.)
/AGENTS.md
/CLAUDE.md
/CONTEXT.md
/MEMORY.md
/BACKLOGS.md
/SPEC.md
/REQUIREMENTS.md
/LESSONS.md
# Legacy rootsator files (TODO/HANDOFF/TESTS <=0.5, CHECKLIST <=0.6, WORKLOG <=0.8); keep them local if an older project still has them.
/WORKLOG.md
/TODO.md
/HANDOFF.md
/TESTS.md
/CHECKLIST.md
*.local.md

# ── Private layout (links into ../<project>_private/) ───────────────────
# Kit documents and kit scripts live in the private sibling. Exact paths and
# no trailing slash: a link to a directory is only matched without one.
# The bootstrap drops this block under "Operating docs location: project".
/DECISIONS.md
/docs/agents
/docs/rfc
/docs/research
/docs/benchmark
/docs/backlogs
/docs/plans
/docs/requirements
/docs/resources
/docs/tests
/docs/handoffs
/scripts/README.md
/scripts/check-tools.sh
/scripts/project-check.sh
/scripts/new-plan.sh
/scripts/archive-plan.sh
/scripts/changelog-entry.sh
/scripts/readme-topline.sh
/scripts/gate.sh
/scripts/gate.conf
/scripts/context-budget.sh
/scripts/brief.sh
/scripts/worklog.sh
/scripts/commit-both.sh
# agy reads .agents/ in place; it stays here, unpublished.
/.agents

# ── Private material and credentials ────────────────────────────────────
# Containment beats guessing: keep ANYTHING sensitive inside one of these
# ignored directories. Then the rest of the project can be fully git-tracked
# without enumerating secret filenames. Do NOT add broad filename globs such as
# *token* or *secret* or *.key — they also hide normal source (tokenizer.c,
# Keynote .key files, etc.).
*_private/
*_internal/
secrets/

# agy customization layer: the MCP config may hold credentials; only the example is tracked.
/.agents/mcp_config.json

# Environment files are the one common in-place secret; commit a template instead.
.env
.env.*
!.env.example
!.env.sample

# ── Cold planning history and generated output ──────────────────────────
docs/plans/active/*.md
docs/plans/archive/*.md
!docs/plans/active/README.md
!docs/plans/archive/README.md
build/
resources/prep/
resources/cache/

# ── Common local noise ──────────────────────────────────────────────────
.DS_Store
*.tmp
*.log

# The PDF editions are built, not kept (they would pile up in history).
docs/*/pdf-*/
/scripts/sot-check.sh
/scripts/claim.sh
/scripts/install-hook.sh
